{
  "name": "react-idb-hooks",
  "version": "1.0.0",
  "description": "Zero-dependency, TypeScript-first React hooks for IndexedDB. Reactive, cross-tab, and React 16.8 - 19 compatible.",
  "keywords": [
    "react",
    "react-hooks",
    "indexeddb",
    "idb",
    "storage",
    "offline",
    "typescript",
    "broadcastchannel",
    "useSyncExternalStore"
  ],
  "author": "Rully Saputra <rullysaputra.business@gmail.com> (https://github.com/rully-saputra15)",
  "license": "MIT",
  "homepage": "https://github.com/rully-saputra15/react-idb-hooks#readme",
  "bugs": {
    "url": "https://github.com/rully-saputra15/react-idb-hooks/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p test-d/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "size": "node ./scripts/size.mjs",
    "prepublishOnly": "npm run build && npm test && npm run test:types"
  },
  "peerDependencies": {
    "react": ">=16.8.0 <20.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rully-saputra15/react-idb-hooks.git"
  }
}
